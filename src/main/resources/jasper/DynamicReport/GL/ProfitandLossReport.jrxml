	<queryString>
		<![CDATA[SELECT DISTINCT COMPANY_NAME
FROM(
SELECT CASE WHEN $P{COMPANY_POID}=999 THEN 'All Companies'
ELSE GCM.COMPANY_NAME END AS COMPANY_NAME
FROM GLOBAL_COMPANY_MASTER GCM
WHERE GCM.COMPANY_POID LIKE DECODE($P{COMPANY_POID},999,'%',$P{COMPANY_POID})
)]]>
	</queryString>
	<field name="COMPANY_NAME" class="java.lang.String"/>
