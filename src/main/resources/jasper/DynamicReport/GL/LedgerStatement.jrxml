		<parameter name="PERIOD_DATE2" class="java.lang.String"/>
		<queryString language="plsql">
			<![CDATA[{call PROC_GL_LEDGER_STATEMENT_PRNT(  $P{COMPANY_POID}, $P{GL_POID}, $P{PERIOD_DATE}, $P{PERIOD_DATE2}, $P{ORACLE_REF_CURSOR} )}]]>
