		<queryString language="SQL">
			<![CDATA[SELECT DOC_DATE, DOC_TYPE, DOC_REF, NARRATION, DR_AMT, CR_AMT, BALANCE
FROM GL_LEDGER_STATEMENT_RPT_TEMP
ORDER BY DET_ROW_ID]]>
		</queryString>
		<field name="DOC_DATE" class="java.sql.Timestamp"/>
		<field name="DOC_TYPE" class="java.lang.String"/>
		<field name="DOC_REF" class="java.lang.String"/>
		<field name="NARRATION" class="java.lang.String"/>
		<field name="DR_AMT" class="java.math.BigDecimal"/>
		<field name="CR_AMT" class="java.math.BigDecimal"/>
		<field name="BALANCE" class="java.lang.String"/>
	</subDataset>
