	<parameter name="THIRD_PERIOD_YEAR" class="java.lang.String"/>
	<parameter name="REPORT_DATE" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT DISTINCT COMPANY_NAME,
CASE WHEN $P{OTHER_INCOME}='Y' AND $P{PROFIT_TYPE}='GROSS_PROFIT' THEN 'Included'
     WHEN $P{PROFIT_TYPE}='NET_PROFIT' THEN 'Included'
ELSE 'Excluded' END AS OTHER_INCOME,
TO_CHAR(TO_DATE($P{PERIOD}),'YYYY') as CURRENT_YEAR_COLUMN, TO_CHAR(TO_CHAR(TO_DATE($P{PERIOD}),'YYYY')-1) as PREVIOUS_YEAR_COLUMN, $P{THIRD_PERIOD_YEAR} as COMPARISON_YEAR_COLUMN
FROM(
    SELECT CASE WHEN $P{COMPANY_POID}=999 THEN 'All Companies'
    ELSE GCM.COMPANY_NAME END AS COMPANY_NAME
    FROM GLOBAL_COMPANY_MASTER GCM
    WHERE GCM.COMPANY_POID LIKE DECODE($P{COMPANY_POID},999,'%',$P{COMPANY_POID})
    )]]>
	</queryString>
	<field name="COMPANY_NAME" class="java.lang.String"/>
	<field name="OTHER_INCOME" class="java.lang.String"/>
	<field name="CURRENT_YEAR_COLUMN" class="java.lang.String"/>
	<field name="PREVIOUS_YEAR_COLUMN" class="java.lang.String"/>
	<field name="COMPARISON_YEAR_COLUMN" class="java.lang.String"/>
