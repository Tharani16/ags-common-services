	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="COMPANY_POID" class="java.lang.String"/>
	<parameter name="PERIOD" class="java.lang.String"/>
	<parameter name="PERIOD2" class="java.lang.String"/>
	<parameter name="LINE1" class="java.lang.String"/>
	<parameter name="CUSTOMER" class="java.lang.String"/>
	<parameter name="BL_TYPE" class="java.lang.String"/>
	<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
	<parameter name="SALESMAN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT COMPANY_NAME,COMPANY_POID,SALESMAN_CODE
FROM(
SELECT CASE WHEN $P{COMPANY_POID}=999 THEN 'All Companies' ELSE GCM.COMPANY_NAME END AS COMPANY_NAME,
CASE WHEN $P{COMPANY_POID}=999 THEN 1 ELSE GCM.COMPANY_POID END AS COMPANY_POID,
GET_SALESMAN_CODE_RPT($P{SALESMAN}) as SALESMAN_CODE
FROM GLOBAL_COMPANY_MASTER GCM
WHERE GCM.COMPANY_POID LIKE DECODE($P{COMPANY_POID},999,'%',$P{COMPANY_POID})
)]]>
	</queryString>
	<field name="COMPANY_NAME" class="java.lang.String"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="SALESMAN_CODE" class="java.lang.String"/>
