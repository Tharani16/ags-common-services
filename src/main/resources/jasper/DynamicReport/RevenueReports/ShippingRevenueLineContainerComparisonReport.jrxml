		<variable name="CUR_YEAR_20_FT" class="java.math.BigDecimal" resetType="Group" resetGroup="BL_TYPE" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_YEAR_20_FT}]]></variableExpression>
		</variable>
		<variable name="CUR_YEAR_40_FT" class="java.math.BigDecimal" resetType="Group" resetGroup="BL_TYPE" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_YEAR_40_FT}]]></variableExpression>
		</variable>
		<variable name="CUR_YEAR_TUES" class="java.math.BigDecimal" resetType="Group" resetGroup="BL_TYPE" calculation="Sum">
