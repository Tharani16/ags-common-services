		</variable>
		<variable name="PREV_YEAR_TUES" class="java.math.BigDecimal" resetType="Group" resetGroup="BL_TYPE" calculation="Sum">
			<variableExpression><![CDATA[$F{PREV_YEAR_TUES}]]></variableExpression>
		</variable>
		<variable name="VARI_20_FT" class="java.math.BigDecimal" resetType="Group" resetGroup="BL_TYPE" calculation="Sum">
			<variableExpression><![CDATA[$F{VARI_20_FT}]]></variableExpression>
		</variable>
		<variable name="VARI_40_FT" class="java.math.BigDecimal" resetType="Group" resetGroup="BL_TYPE" calculation="Sum">
