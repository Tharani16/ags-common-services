		</variable>
		<variable name="PER_20FT" class="java.math.BigDecimal">
			<variableExpression><![CDATA[(($V{VARI_20_FT}/$V{PREV_YEAR_20_FT})*100).setScale(2, java.math.RoundingMode.HALF_UP)]]></variableExpression>
		</variable>
		<variable name="PER_40FT" class="java.math.BigDecimal">
